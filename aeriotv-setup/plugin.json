{
  "name": "AerioTV Setup",
  "version": "0.1.0",
  "description": "Preconfigure a user's AerioTV favorites, group order, hidden groups, and settings. Their AerioTV devices offer Dispatcharr Sync on first launch and start from this setup.",
  "author": "jonzey231",
  "license": "AGPL-3.0-or-later",
  "min_dispatcharr_version": "0.33.0",
  "repo_url": "https://github.com/jonzey231/AerioTVDispatcharrPlugin",
  "help_url": "https://github.com/jonzey231/AerioTVDispatcharrPlugin",
  "fields": [
    {
      "id": "intro",
      "type": "info",
      "label": "How it works",
      "description": "Fill in the user and any of the sections below, save, then run Preview and Apply. Blank sections are left alone. Use Show Channels and Show Groups to find channel ids and group names for that user."
    },
    {
      "id": "target_username",
      "label": "User",
      "type": "string",
      "default": "",
      "placeholder": "Dispatcharr username",
      "help_text": "The Dispatcharr user whose AerioTV setup this writes."
    },
    {
      "id": "favorites",
      "label": "Favorite channels",
      "type": "text",
      "default": "",
      "placeholder": "1042, 77, 903",
      "help_text": "Channel ids in display order, separated by commas or new lines. Not channel numbers."
    },
    {
      "id": "group_order_mode",
      "label": "Group order",
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Leave as is"
        },
        {
          "value": "default",
          "label": "Server order"
        },
        {
          "value": "alphabetical",
          "label": "Alphabetical"
        },
        {
          "value": "manual",
          "label": "Manual (use the list below)"
        }
      ]
    },
    {
      "id": "group_order",
      "label": "Manual group order",
      "type": "text",
      "default": "",
      "help_text": "One Live TV group name per line, exactly as the server names it."
    },
    {
      "id": "hidden_groups_live",
      "label": "Hidden Live TV groups",
      "type": "text",
      "default": "",
      "help_text": "One group name per line."
    },
    {
      "id": "hidden_groups_movies",
      "label": "Hidden movie groups",
      "type": "text",
      "default": "",
      "help_text": "One group name per line."
    },
    {
      "id": "hidden_groups_series",
      "label": "Hidden series groups",
      "type": "text",
      "default": "",
      "help_text": "One group name per line."
    },
    {
      "id": "selected_theme",
      "label": "Theme",
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Leave as is"
        },
        {
          "value": "Aerio",
          "label": "Aerio"
        },
        {
          "value": "Midnight",
          "label": "Midnight"
        },
        {
          "value": "Sunset",
          "label": "Sunset"
        },
        {
          "value": "Forest",
          "label": "Forest"
        },
        {
          "value": "Lavender",
          "label": "Lavender"
        },
        {
          "value": "Monochrome",
          "label": "Monochrome"
        },
        {
          "value": "Light",
          "label": "Slate"
        }
      ]
    },
    {
      "id": "appearance_mode",
      "label": "Mode",
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Leave as is"
        },
        {
          "value": "system",
          "label": "System"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "id": "default_group",
      "label": "Default group",
      "type": "string",
      "default": "",
      "help_text": "The Live TV group AerioTV opens to, exactly as the server names it."
    },
    {
      "id": "apply_mode",
      "label": "Apply mode",
      "type": "select",
      "default": "fill",
      "options": [
        {
          "value": "fill",
          "label": "Fill (only add what the record does not have yet)"
        },
        {
          "value": "replace",
          "label": "Replace (overwrite the sections filled in above)"
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "show_channels",
      "label": "Show Channels",
      "description": "Lists the channels this user can see, with ids and groups.",
      "button_label": "Show",
      "button_variant": "outline"
    },
    {
      "id": "show_groups",
      "label": "Show Groups",
      "description": "Lists the Live TV groups this user can see.",
      "button_label": "Show",
      "button_variant": "outline"
    },
    {
      "id": "preview",
      "label": "Preview",
      "description": "Shows what Apply would change, without writing.",
      "button_label": "Preview",
      "button_variant": "outline"
    },
    {
      "id": "apply",
      "label": "Apply",
      "description": "Writes the setup to the user's AerioTV record.",
      "button_label": "Apply",
      "button_variant": "filled",
      "button_color": "blue",
      "confirm": {
        "required": true,
        "title": "Apply AerioTV setup?",
        "message": "This writes the user's AerioTV record. Replace mode overwrites what their devices saved for the sections you filled in."
      }
    }
  ]
}
